# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Envío de recordatorios de cobro (SMTP). Con Gmail: contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
# Opcional: remitente visible, p. ej. "Mi Marca <tucorreo@gmail.com>"
SMTP_FROM=

# Clave para cifrar las contraseñas de Gmail que conectan los usuarios.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CORREO_CLAVE_CIFRADO=
